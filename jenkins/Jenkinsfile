pipeline {
    agent none

    parameters {
        choice(
            name: 'select_environment',
            choices: ['dev', 'prod'],
            description: 'Select deployment environment'
        )
    }

    stages {

        stage('Build') {
            agent {
                label 'server1'
            }

            steps {
                sh '''
                echo "Building Python application..."

                mkdir -p artifacts

                echo "Hello World from Python Application" > artifacts/index.html

                zip -r artifacts/pythonapp.zip app.py .gitignore artifacts/index.html

                echo "Build completed"
                ls -l artifacts
                '''

                stash name: 'python-build', includes: 'artifacts/**'
            }
        }

        stage('Test') {
            parallel {

                stage('Run Application Test on Server1') {
                    agent {
                        label 'server1'
                    }

                    steps {
                        unstash 'python-build'

                        sh '''
                        echo "Running application test..."
                        python3 app.py
                        '''
                    }
                }

                stage('Syntax Check on Server2') {
                    agent {
                        label 'server2'
                    }

                    steps {
                        unstash 'python-build'

                        sh '''
                        echo "Running syntax check..."
                        python3 -m py_compile app.py
                        '''
                    }
                }
            }
        }

        stage('Deploy to DEV Server') {
            when {
                expression { params.select_environment == 'dev' }
                beforeAgent true
            }

            agent {
                label 'server1'
            }

            steps {

                unstash 'python-build'

                sh '''
                echo "Deploying to DEV..."

                sudo mkdir -p /var/www/html
                sudo rm -rf /var/www/html/*

                sudo cp artifacts/index.html /var/www/html/index.html
                sudo cp artifacts/pythonapp.zip /var/www/html/pythonapp.zip

                ls -l /var/www/html
                '''
            }
        }

        stage('Approval for PROD Deployment') {
            when {
                expression { params.select_environment == 'prod' }
                beforeAgent true
            }

            steps {
                input(
                    message: 'Deploy to Production?',
                    ok: 'Approve'
                )
            }
        }

        stage('Deploy to PROD Server') {
            when {
                expression { params.select_environment == 'prod' }
                beforeAgent true
            }

            agent {
                label 'server2'
            }

            steps {

                unstash 'python-build'

                sh '''
                echo "Deploying to PROD..."

                sudo mkdir -p /var/www/html
                sudo rm -rf /var/www/html/*

                sudo cp artifacts/index.html /var/www/html/index.html
                sudo cp artifacts/pythonapp.zip /var/www/html/pythonapp.zip

                ls -l /var/www/html
                '''
            }
        }
    }

    post {
        success {
            echo "Pipeline completed successfully"
        }

        failure {
            echo "Pipeline failed"
        }

        aborted {
            echo "Deployment approval was rejected or aborted"
        }
    }
}